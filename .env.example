# Pick ONE model provider for the Strands agent.

# Anthropic
ANTHROPIC_API_KEY=

# OR OpenAI
# OPENAI_API_KEY=

# OR Google Gemini — has a genuinely free tier (no credit card needed).
# Get a key at https://aistudio.google.com/apikey
# GOOGLE_API_KEY=

# OR leave all three blank to use the default Amazon Bedrock provider,
# in which case set standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY instead.

# Optional: real email sending via Resend (https://resend.com).
# If left blank, the agent logs the "sent" email to the console/ledger
# instead of actually sending it — handy for demoing without setup.
RESEND_API_KEY=
FOLLOWUP_FROM_EMAIL=agent@example.com
